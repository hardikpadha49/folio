# ============================================================
# FolioPulse AI — Environment Variables Template
# Copy this to .env and fill in real values.
# NEVER commit the real .env file.
# ============================================================

# ----- Database -----
DATABASE_URL=postgresql://foliopulse:yourpassword@localhost:5432/foliopulse_db

# ----- Auth -----
# Generate with: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_USE_OPENSSL_RAND_HEX_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ----- Market Data (Phase 2) -----
ALPHA_VANTAGE_API_KEY=YOUR_ALPHA_VANTAGE_KEY

# ----- AI / LLM (Phase 6) -----
GOOGLE_API_KEY=YOUR_GEMINI_API_KEY

# ----- Cache (Phase 2) -----
REDIS_URL=redis://localhost:6379

# ----- KYC / Sandbox (Phase 7) -----
DIGIO_CLIENT_ID=YOUR_DIGIO_SANDBOX_CLIENT_ID
DIGIO_CLIENT_SECRET=YOUR_DIGIO_SANDBOX_SECRET
DIGIO_BASE_URL=https://ext.digio.in:444

# ----- CORS -----
FRONTEND_URL=http://localhost:3000

# ----- Environment -----
APP_ENV=development
